{
    "name": "abli-code",
    "version": "1.0.0",
    "description": "Abli Code â€” Open-source Abliterated AI routing gateway, web console, and Electron desktop coding IDE.",
    "type": "module",
    "main": "desktop/main.mjs",
    "license": "MIT",
    "author": "Umar Al-Fateh Suhaimi <umaralfatehsuhaimi02@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/umaralfatehsuhaimi02-rgb/abli-code"
    },
    "scripts": {
        "dev:web": "vite",
        "build": "vite build",
        "start": "node server.mjs",
        "launch": "npm run build && node server.mjs",
        "desktop": "electron .",
        "desktop:build": "npm run build && electron .",
        "dist": "npm run build && electron-builder",
        "test": "node scripts/test.mjs"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.49.1",
        "lucide-react": "^0.475.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "stripe": "^23.2.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "electron": "45.2.2",
        "electron-builder": "26.18.1",
        "typescript": "^5.6.0",
        "vite": "^6.0.0"
    },
    "build": {
        "appId": "com.ablicode.desktop",
        "productName": "Abli Code",
        "files": [
            "desktop/**/*",
            "dist/**/*",
            "lib/**/*",
            "server.mjs",
            "package.json",
            "LICENSE"
        ],
        "directories": {
            "output": "release"
        },
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage",
            "category": "Development"
        }
    },
    "bin": {
        "abli": "bin/abli.mjs"
    }
}
